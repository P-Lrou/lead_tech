# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- Rate limiter: shared token bucket store -------------------------------
# When REDIS_HOST is set, the token buckets live in Redis and are shared by
# every API instance (horizontal scaling). When it is empty, an in-memory Map
# is used instead (single instance only, e.g. local dev / CI).
# Ask a maintainer for the development Redis credentials.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=

# --- MCP endpoint --------------------------------------------------------------
# Bearer token accepted by POST /mcp in the "Authorization" header.
# Defaults to "MY_HARDCODED_API_KEY" when unset.
MCP_API_KEY=MY_HARDCODED_API_KEY
